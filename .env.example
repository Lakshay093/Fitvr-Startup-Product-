# Fit.VR platform
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000
FITVR_API_URL=http://localhost:4000
CORS_ORIGIN=http://localhost:3000

# Auth
JWT_SECRET=replace-with-a-32-char-minimum-secret
COOKIE_SECRET=replace-with-a-32-char-minimum-secret

# Database and cache
DATABASE_URL=postgresql://fitvr:fitvr@localhost:5432/fitvr?schema=public
REDIS_URL=redis://localhost:6379

# Storage
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=fitvr-assets
S3_ACCESS_KEY=fitvr
S3_SECRET_KEY=fitvr-password
CDN_BASE_URL=https://cdn.fitvr.example

# Observability
SENTRY_DSN=
LOG_LEVEL=info

# Billing
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
